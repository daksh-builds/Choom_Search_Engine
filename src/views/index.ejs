<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Mini Search Engine</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#f5f5f5;
}

.container{
    width:90%;
    max-width:700px;
    text-align:center;
}

h1{
    margin-bottom:30px;
    font-size:3rem;
}

.search-box{
    display:flex;
    gap:10px;
}

input{
    flex:1;
    padding:15px;
    font-size:18px;
    border:1px solid #ccc;
    border-radius:8px;
    outline:none;
}

button{
    padding:15px 25px;
    border:none;
    background:#4285f4;
    color:white;
    border-radius:8px;
    cursor:pointer;
    font-size:16px;
}

button:hover{
    background:#2f6fe0;
}
</style>

</head>
<body>

<div class="container">

    <h1>Search Engine</h1>

    <form action="/api/search" method="GET">

        <div class="search-box">

            <input
                type="text"
                name="q"
                placeholder="Search anything..."
                required
            >

            <button type="submit">
                Search
            </button>

        </div>

    </form>

</div>

</body>
</html>